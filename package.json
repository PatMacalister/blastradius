{
  "name": "@mediaforge/blastradius",
  "version": "0.2.0",
  "description": "What can the credentials on this machine actually destroy?",
  "keywords": [
    "security",
    "credentials",
    "secrets",
    "scanner",
    "least-privilege",
    "ai-agents",
    "mcp"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Patrick Hasse (Mediaforge)",
  "homepage": "https://blastradius.patrickhasse.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatMacalister/blastradius.git"
  },
  "bugs": {
    "url": "https://github.com/PatMacalister/blastradius/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "blastradius": "src/cli.mjs"
  },
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "scan": "node src/cli.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:contract": "node --test test/contract/*.test.mjs",
    "test:contract:local": "node --env-file=ops/contract-tests.env --test test/contract/*.test.mjs",
    "changelog:scan": "node tools/changelog-scan.mjs"
  }
}
